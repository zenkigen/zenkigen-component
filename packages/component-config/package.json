{
  "name": "@zenkigen-inc/component-config",
  "version": "2.0.0-rc.4",
  "repository": "https://github.com/zenkigen/zenkigen-component",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/index.css"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build:tokens": "token-transformer style-dictionary/tokens.json style-dictionary/transformed-tokens.json --preserveRawValue=true && node build.cjs",
    "build": "rimraf dist && tsup src/index.ts --format cjs,esm --dts && node src/generate-styles.mts",
    "build-lib": "rimraf dist && tsup src/index.ts --format cjs,esm --dts && node src/generate-styles.mts"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "style-dictionary": "5.8.0",
    "token-transformer": "0.0.33",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@zenkigen-inc/component-theme": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
