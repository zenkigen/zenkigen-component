{
  "name": "zenkigen-component",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*"
  ],
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "scripts": {
    "lint": "eslint './packages/**/*.ts{,x}' && prettier --check .",
    "lint:fix": "eslint './packages/**/*.ts{,x}' --fix && prettier --write .",
    "check-filenames": "node scripts/check-filename-case.mjs",
    "lint:all": "yarn lint && yarn check-filenames",
    "type-check": "yarn workspaces foreach --all --exclude zenkigen-component run type-check",
    "build:all": "yarn workspaces foreach --all -pt --exclude zenkigen-component run build",
    "build-lib:all": "yarn workspaces foreach --all -pt --exclude zenkigen-component run build-lib",
    "publish:all": "yarn workspaces foreach --all --exclude zenkigen-component npm publish",
    "storybook": "storybook dev -p 6006",
    "create-component": "yarn workspace @zenkigen-inc/component-ui hygen generator components",
    "update-tokens": "yarn workspace @zenkigen-inc/component-config run build:tokens",
    "test": "yarn workspace @zenkigen-inc/component-ui run test",
    "test:ci": "yarn workspace @zenkigen-inc/component-ui run test:ci",
    "build-storybook": "storybook build",
    "clean": "rimraf node_modules",
    "prepare": "husky"
  },
  "resolutions": {
    "vite": "7.3.7",
    "rollup": "4.64.10"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__preset-env": "7.10.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "eslint-plugin-tailwindcss": "3.18.3",
    "glob": "11.1.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "24.1.3",
    "lint-staged": "16.4.0",
    "mockdate": "3.0.5",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
