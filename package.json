{
  "name": "zenkigen-component",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=12.4.0 <13"
  },
  "scripts": {
    "lint": "eslint './packages/**/*.ts{,x}' && prettier --check .",
    "lint:fix": "eslint './packages/**/*.ts{,x}' --fix && prettier --write .",
    "check-filenames": "node scripts/check-filename-case.mjs",
    "lint:all": "pnpm lint && pnpm check-filenames",
    "type-check": "pnpm -r --if-present run type-check",
    "build:all": "pnpm -r run build",
    "build-lib:all": "pnpm -r run build-lib",
    "publish:all": "pnpm -r publish",
    "storybook": "storybook dev -p 6006",
    "create-component": "pnpm --filter @zenkigen-inc/component-ui exec hygen generator components",
    "update-tokens": "pnpm --filter @zenkigen-inc/component-config run build:tokens",
    "test": "pnpm --filter @zenkigen-inc/component-ui run test",
    "test:ci": "pnpm --filter @zenkigen-inc/component-ui run test:ci",
    "build-storybook": "storybook build",
    "clean": "rimraf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-links": "10.5.5",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/react-vite": "10.5.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__preset-env": "7.10.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "5.2.0",
    "@zenkigen-inc/component-config": "workspace:*",
    "@zenkigen-inc/component-ui": "workspace:*",
    "autoprefixer": "10.5.4",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "10.5.5",
    "eslint-plugin-tailwindcss": "3.18.3",
    "glob": "11.1.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "24.1.3",
    "lint-staged": "16.4.0",
    "mockdate": "3.0.5",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "catalog:",
    "storybook": "10.5.5",
    "tailwindcss": "catalog:",
    "terser": "5.49.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
